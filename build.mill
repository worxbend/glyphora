//| mvnDeps: ["com.goyeau::mill-scalafix::0.6.2"]

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.javalib.*
import mill.javalib.DepSyntax
import mill.javalib.publish.*
import mill.scalalib.SbtModule

object `package` extends Module {

  /** Shared conventions for every Scala module in this repo: Scala version, strict compiler flags, ScalaTest wiring. */
  trait TuiModule extends SbtModule with ScalafixModule {

    def scalaVersion = "3.9.0"

    /** JDK 25 or newer, declared rather than left to whatever JDK happened to compile it. Coupled to
      * `TuiExampleModule.jvmVersion` below: `-release:N` is only accepted when the JVM running scalac is itself feature
      * `>= N` (Scala 3.9.0's `supportedReleaseVersions` is `17 to min(Runtime.version().feature, 26)`), and Mill
      * compiles every example in a Zinc subprocess under that `jvmVersion` — so this and the GraalVM pin below move
      * together or the `build` job fails at scalac option parsing on the older of the two.
      */
    def scalacOptions = super.scalacOptions() ++ Seq(
      "-deprecation",
      "-feature",
      "-unchecked",
      "-Wunused:all",
      "-Werror",
      "-release:25",
    )

    /** Test sources are held to the same Scalafix rules as main sources.
      *
      * Without `ScalafixModule` here, `./mill __.fix` walked main sources only — so the `DisableSyntax` rules the repo
      * does enforce (no `asInstanceOf`, no `isInstanceOf`, no `null`) were unchecked in exactly the sources that are
      * most tempted by them. A test asserting on a node type says what it means as a pattern match.
      */
    trait TuiTests extends SbtTests with TestModule.ScalaTest with ScalafixModule {

      /** Extra test-only dependencies a module can add without re-overriding `mvnDeps` (Mill cannot resolve a second
        * `super.mvnDeps` chain in nested test objects).
        */
      def extraTestDeps: Seq[Dep] = Seq.empty

      def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.scalatest::scalatest:3.2.20") ++ extraTestDeps

      /** One forked JVM per test class, instead of Mill's default of one group work-stolen across N workers.
        *
        * Two pieces of state are process-global and would otherwise be shared by whichever suites happened to land in
        * the same worker: `RenderThread`'s registry, which decides where a `Signal` write is routed, and the
        * `AnimationClock` a caller with no runner of its own reads — `freezeAt` pins that one, and the value it pins
        * also seeds the clock of any runner started afterwards. Because the default grouping is not stable between
        * runs, a suite that pins the clock and a suite whose runners tick it would decide each other's frames on some
        * runs and not others — which is exactly the "`./mill __.test` is flaky" symptom.
        *
        * Parallelism is unaffected: the classes still run concurrently, just in JVMs that cannot see each other.
        */
      def testForkGrouping: T[Seq[Seq[String]]] = Task { discoveredTestClasses().map(Seq(_)) }
    }

    /** Test module for anything that uses `test-support` helpers without driving a whole app through `Pilot`:
      * `TuiTests` plus the test-support module. Shape-wise it is [[TuiPilotTests]]'s body under a name that does not
      * claim a Pilot harness runs here — terminal and widgets pull in `test-support` for the shared `Bench` harness
      * alone.
      */
    trait TuiSupportTests extends TuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(build.`test-support`)
    }

    /** Test module for anything that drives a whole app through `Pilot`: [[TuiSupportTests]] under a name that says the
      * harness is the point.
      *
      * Its own `object test` cannot live here — a trait cannot both be the test module and contain it — so modules
      * declare `object test extends TuiPilotTests` themselves.
      */
    trait TuiPilotTests extends TuiSupportTests
  }

  /** Every `examples/<name>` module: the library conventions, a native image, the GraalVM pin, and a Pilot-capable test
    * submodule. An example's own `package.mill` then declares only what actually differs — its `moduleDeps` and its
    * `mainClass`.
    *
    * The GraalVM version lives here rather than in ten files, so bumping it is one edit that cannot be half-applied.
    */
  trait TuiExampleModule extends TuiModule with NativeImageModule {

    /** GraalVM distribution pinned for every example's native image; Mill downloads it automatically.
      *
      * Also the JDK every example compiles under (`JavaTests.jvmVersion` follows the outer module's), which is why this
      * is JDK 25 — the floor `TuiModule.scalacOptions`' `-release:25` declares. macOS x64 has no GraalVM CE build past
      * 25.0.1 (25.0.2 dropped it); ubuntu-latest, the only platform CI builds on, is unaffected, but a contributor on
      * an Intel Mac needs 25.0.1 to build an example locally, and CONTRIBUTING.md says nothing about it today.
      */
    def jvmVersion = "graalvm-community:25.0.2"

    /** CI requires every example to build with no fallback image, which is what proves the no-reflection rule holds.
      * `--enable-native-access=ALL-UNNAMED` silences the JEP 472 warnings JLine 4's native access otherwise prints
      * (four WARNING lines) at every binary startup.
      */
    def nativeImageOptions = Seq("--no-fallback", "--enable-native-access=ALL-UNNAMED")

    object test extends TuiPilotTests
  }

  /** Published `tui-*` modules: shared POM metadata and the single synchronized version. */
  trait TuiPublishModule extends TuiModule with PublishModule {

    def moduleDescription: String

    def pomSettings = PomSettings(
      description = moduleDescription,
      organization = "io.worxbend",
      url = "https://github.com/oleksandr-balyshyn/glyphora",
      licenses = Seq(License.MIT),
      versionControl = VersionControl.github("oleksandr-balyshyn", "glyphora"),
      developers = Seq(Developer("limpid-kzonix", "limpid-kzonix", "https://github.com/limpid-kzonix")),
    )

    def publishVersion = "0.17.0"
  }
}
